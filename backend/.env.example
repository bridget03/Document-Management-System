APP_ENV=development
DATABASE_URL=postgresql+psycopg2://dms_user:<mat-khau>@localhost:5433/dms
# For local dev without postgres, use: sqlite:///./dms.db
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=60
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-drive/callback
# Fernet key for Drive OAuth token encryption at rest (required in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRIVE_TOKEN_KEY=
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly
SYNC_INTERVAL_MINUTES=30
CORS_ORIGINS=http://localhost:5173
